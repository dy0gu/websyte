{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!src/payload-types.ts", "!src/app/(payload)/admin/import-map.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "preset": "recommended",
        "useSortedPackageJson": "on",
        "useSortedAttributes": "on",
        "noDuplicateClasses": "on",
        "useSortedProperties": "on",
        "useSortedEnumMembers": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noProcessEnv": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./*", "../*"],
                "message": "Use `~/` for imports from `src` or `$/` for root imports, relative imports are forbidden."
              }
            ]
          }
        },
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentCurlyBraces": "error",
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "explicit"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        },
        "useSelfClosingElements": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/(payload)/admin/import-map.js"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["biome.json", "package.json", "src/migrations/**"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["env.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/i18n/types.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "knip.config.ts",
        "next.config.ts",
        "playwright.config.ts",
        "src/app/**",
        "src/i18n/request.ts",
        "src/payload.config.ts",
        "src/proxy.ts",
        "vitest.config.mts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/footer/config.ts", "src/header/config.ts", "src/payload.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/migrations/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
