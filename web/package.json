{
  "name": "websyte",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm generate && next build",
    "check": "biome check . && fallow --no-cache --fail-on-issues --only dead-code,dupes",
    "check:fix": "biome check --write .",
    "dev": "next dev",
    "generate": "payload generate:types && payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:reset": "payload migrate:reset",
    "seed": "payload run src/seeds/run.ts",
    "start": "next start",
    "test": "pnpm run test:migrate && pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_ENV=test PORT=5624 PUBLIC_SERVER_URL=http://localhost:5624 playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_ENV=test vitest run --config ./vitest.config.mts",
    "test:migrate": "cross-env NODE_ENV=test payload migrate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "payload": "3.90.2",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "esbuild": "0.28.0",
    "fallow": "3.32.0",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@11.24.0+sha1.a042a648b5e519c43c5b2c3ff99901448190cd66",
  "engines": {
    "node": "24.21.0"
  }
}
