# Database connection string
DATABASE_URL=postgres://db_user:db_password@127.0.0.1:5432/websyte

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
PUBLIC_SERVER_URL=http://localhost:3000

# Receives contact-form notifications and powers the homepage email link
CONTACT_EMAIL=

# SMTP transport for outgoing email. Defaults point to the local Mailpit catcher
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@websyte.local
# Leave empty when using the local Mailpit catcher (no auth required)
SMTP_USER=
SMTP_PASS=

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
